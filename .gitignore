# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and secrets
.venv/
venv/
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Data: raw and interim are never committed
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/raw/**/*.parquet
data/interim/**/*.parquet

# Node
node_modules/
app/dist/
.netlify/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/

# Reference downloads that the scripts can re-create (airports_tz.csv itself is committed)
data/reference/ourairports_airports.csv
data/reference/openflights_airports.dat

# Safety net: no parquet files anywhere (rotation outputs in data/processed are large; small CSVs there are fine).
# data/processed/aa_clean_v1.0.parquet (68 MB, over the 50 MB limit) is distributed as a GitHub Release asset under
# tag data-v1.0; data/sample/aa_clean_sample.csv, data/CHECKSUMS.sha256 and data/data_manifest.json ARE committed.
*.parquet

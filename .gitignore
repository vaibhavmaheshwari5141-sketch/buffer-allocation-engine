# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and secrets
.venv/
venv/
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Data: raw and interim are never committed
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/raw/**/*.parquet
data/interim/**/*.parquet

# Node
node_modules/
app/dist/
.netlify/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/

# Reference downloads that the scripts can re-create (airports_tz.csv itself is committed)
data/reference/ourairports_airports.csv
data/reference/openflights_airports.dat

# Safety net: no data files outside the git-ignored folders
*.parquet
!data/processed/*.parquet
